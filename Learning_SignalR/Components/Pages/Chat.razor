@page "/chat"
@using Learning_SignalR.Services
@using Microsoft.AspNetCore.SignalR.Client
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IChatService ChatService
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Chat</PageTitle>

<h1>Chat</h1>

<textarea class="form-control" readonly id="chatbox" style="height: 300px;">@string.Join("\n", messages)</textarea>
<input class="form-control" placeholder="Type a message..." @bind="Message" @bind:event="oninput" @onkeyup="HandleKeyUp" />

<button class="btn btn-primary" @onclick="AddChat" disabled="@(!IsConnected)">Send</button>

@code {

    private string Message { get; set; } = string.Empty;
    private List<string> messages = new();
    private HubConnection? hubConnection;

    public bool IsConnected =>
        hubConnection?.State == HubConnectionState.Connected;

    protected override async Task OnInitializedAsync()
    {
        var existingMessages = await ChatService.GetAllMessages();
        messages.AddRange(existingMessages);
        
        if (hubConnection is not null) return;

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<string>("ReceiveMessage", async (msg) =>
        {
            messages.Add(msg);
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        });
        
        await hubConnection.StartAsync();

    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollToBottom();
        }
    }
    
    private async Task ScrollToBottom()
    {
        // We use a small delay or ensure StateHasChanged has finished 
        // to make sure the textarea has rendered the new text.
        await JS.InvokeVoidAsync("scrollToBottom", "chatbox");
    }
    
    private async Task AddChat()
    {
        if (!string.IsNullOrWhiteSpace(Message) && hubConnection is not null)
        {
            await ChatService.SendMessage(Message);
            Message = string.Empty;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddChat();
        }
    }
   
    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}